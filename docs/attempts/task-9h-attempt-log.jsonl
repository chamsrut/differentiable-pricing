rate_time", "yield_time"], "git_commit": "969c74ac15e9ea0a246a3bdf7788831a79ae5171", "hypothesis": "The residual backbone's price accuracy and the premium head's European floor compose: at matched capacity, rows and budget, the head removes the european_comparator_lower_bound violations without the price cost it showed at control capacity.", "interpretation": "The residual-premium diagnostic failed badly on price: normalized RMSE 0.006852205444033097, p99 0.03249641860634549 and maximum 0.13867056125662663, closely reproducing the small premium-head model despite residual capacity. This falsifies insufficient capacity as the principal explanation for the premium head's price cost. It reduced shape violations from 683 to 312 and eliminated spot-monotonicity violations, but retained 6925 bound violations: 5839 against the CRR European comparator and 1086 against intrinsic value. The analytic European anchor therefore does not enforce the stored CRR comparator, while the premium-target reparameterization destroys the direct residual model's price accuracy.", "next_action": "change-direction implement E2 as a smooth lower-floor output transformation over the preserved direct normalized-price target and residual backbone, using analytic European and intrinsic floors without reusing the premium target; quantify the analytic-European versus CRR-comparator discrepancy before running it", "optimizer_and_budget": {"batch_size": 2048, "beta1": 0.9, "beta2": 0.999, "deterministic_algorithms": true, "epochs": 120, "epsilon": 1e-08, "learning_rate": 0.001, "minimum_learning_rate": 0.0, "name": "adamw", "num_threads": 4, "schedule": "cosine_annealing", "schedule_period_epochs": 120, "shuffle": "torch.randperm from the shuffle seed once per epoch", "weight_decay": 1e-06}, "outcome": "criterion_not_met", "parent_attempt": "scratch_residual_architecture_v1", "price_metrics": {"best_epoch": 118, "european_crr_baseline_normalized": {"mae": 0.005560348888468108, "maximum_absolute_error"